# ============================================
# VOLARA - CONFIGURACIÓN DE ENTORNO
# ============================================
# Este archivo documenta todas las variables 
# de entorno necesarias. 
# 
# NUNCA versiones el archivo .env real
# Copia este archivo a .env y actualiza con tus valores

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_NAME=volara_db
DB_USER=root
DB_PASS=

# ============================================
# CORREO (GMAIL SMTP)
# ============================================
# Nota: Usar contraseña de APLICACIÓN de Google
# NO usar la contraseña normal de Gmail
# Generar en: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=volara.aerolinea@gmail.com
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# ============================================
# APLICACIÓN
# ============================================
APP_NAME=VOLARA
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/volara-sistema-aerolineas

# ============================================
# SESIONES Y SEGURIDAD
# ============================================
SESSION_LIFETIME=3600
CANCELACION_HORAS=72
